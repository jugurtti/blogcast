# BlogCast Configuration

# Public URL used in generated RSS feed and episode links.
BLOGCAST_BASE_URL=https://your-domain.example

# Optional blog sources.
# Multiple URLs may be separated by commas or line breaks.
BLOGCAST_BLOG_URLS=

# Optional PDF source.
# Enable the matching volume mount in docker-compose.yml first.
# Linux:   /volume1/Blogcast
# macOS:   /Users/username/Documents/Blogcast
# Windows: C:\Blogcast
BLOGCAST_PDF_PATH=

# Podcast feed metadata.
BLOGCAST_FEED_TITLE=BlogCast
BLOGCAST_FEED_AUTHOR=Your Name
BLOGCAST_FEED_DESCRIPTION=Turning blog posts into podcast episodes

# Languages to handle, in order of preference. The first entry is the
# fallback when detection is inconclusive, and the feed's <language>.
BLOGCAST_LANGUAGES=fi,en

# One voice per language above.
# Finnish:  Noora, Harri
# English:  Aria, Guy, Sonia, Ryan
# Any other language needs a full edge-tts voice ID, e.g. de-DE-KatjaNeural.
BLOGCAST_VOICE_FI=Noora
BLOGCAST_VOICE_EN=Aria

# Spoken dates come from Babel, which knows month names and word order for
# every common language. These overrides are rarely needed.
# BLOGCAST_MONTHS_XX=Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec
# BLOGCAST_DATE_FORMAT_XX={day}. {month} {year}

# Optional spoken intro and outro. Placeholders: {blog} {date} {title}.
# Without a language suffix they apply to every language.
# An empty value disables that part of the episode.
# BLOGCAST_INTRO=
# BLOGCAST_OUTRO=
# BLOGCAST_INTRO_FI={blog}. {date}. {title}.
# BLOGCAST_OUTRO_FI=Tähän päättyy {blog} teksti {title}.

# Runtime settings.
# UPDATE_INTERVAL is in seconds (3600 = 1 hour).
UPDATE_INTERVAL=3600
PORT=8000
TZ=Europe/Helsinki
